title                   = NVT equilibration
define                  = -DPOSRES

integrator              = md
nsteps                  = 100000
dt                      = 0.001

nstxout-compressed      = 500
nstenergy               = 500
nstlog                  = 500

continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds

cutoff-scheme           = Verlet
nstlist                 = 20

coulombtype             = PME
rcoulomb                = 1.0

vdwtype                 = Cut-off
rvdw                    = 1.0

tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1 0.1
ref_t                   = 300 300

pcoupl                  = no

pbc                     = xyz

gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
